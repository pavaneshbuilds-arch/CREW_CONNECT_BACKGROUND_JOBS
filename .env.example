# Same PostgreSQL database as CREW_CONNECT_API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crew_connect?schema=public

# How often the worker looks for due reminders and unsent notifications.
POLL_INTERVAL_MS=5000
PUSH_BATCH_SIZE=50
LOG_LEVEL=debug

# Firebase Admin SDK service account keys for FCM. Do not commit the keys.
# Firebase console → Project settings → Service accounts → Generate new private key.
# This is not google-services.json. If both apps are in one Firebase project, use the
# same file for both. For each app, set PATH to the JSON file, or JSON to the same
# JSON as one line or base64.

# User (organizer) app project
FCM_USER_SERVICE_ACCOUNT_PATH=
FCM_USER_SERVICE_ACCOUNT_JSON=

# Crew app project
FCM_CREW_SERVICE_ACCOUNT_PATH=
FCM_CREW_SERVICE_ACCOUNT_JSON=
